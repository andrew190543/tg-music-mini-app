# Copy this file to .env and fill in the values.
# Telegram bot token from @BotFather.
BOT_TOKEN=

# Public HTTPS base URL of the Mini App, WITHOUT the /app suffix.
# Example: https://random-words.trycloudflare.com
# Local tunnel: cloudflared tunnel --url http://localhost:8080
# The bot adds /app automatically for the inline button and menu button.
WEBAPP_URL=

HOST=0.0.0.0
PORT=8080
DB_PATH=data/music.db
LOG_LEVEL=INFO

# Proxy for YouTube access (yt-dlp and the streaming/thumbnail proxy).
# Example: http://127.0.0.1:10809 or socks5h://127.0.0.1:10808
# Leave empty to auto-detect a local Xray/Happ inbound on 127.0.0.1
# (10808 socks5h, 10809 http, 1080 socks5h, 2080 http).
# Set to "none" to force a direct connection.
YTDLP_PROXY=

# Authentication of favorites API requests:
#   auto (default) - when BOT_TOKEN is set, /api/favorites* require the Mini
#                    App to send valid signed initData in the
#                    "Authorization: tma <initData>" header; user_id sent by
#                    the client is then ignored. Without a BOT_TOKEN (local
#                    development/tests) the explicit user_id is accepted.
#   off            - always accept the explicit user_id, even with a token.
AUTH_MODE=auto
